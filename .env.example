# ENES'AI SUPER MARKET — environment (copy to .env and fill in). NEVER commit .env.
# development | production  (production hides placeholders, enables HTTPS cookie flags)
ENESAI_ENV=development
# Long random value (python -c "import secrets;print(secrets.token_hex(32))"). Required in production.
SECRET_KEY=
# true behind HTTPS (Secure cookies + HSTS). Always true in production.
ENESAI_HTTPS=false
# Public address used in sitemap/robots/e-mails, e.g. https://www.enesai.al
PUBLIC_BASE_URL=
# Data folder (database, uploads, private invoices). Default: ./instance
# ENESAI_INSTANCE=
# Admin URL path (default /paneli). A secret path is only obscurity, never protection.
ADMIN_PATH=paneli
# Login lockout: failures per username+IP and minutes locked
LOGIN_MAX_FAILURES=6
LOGIN_LOCK_MINUTES=15
# Cart line cap (C-17), coupon max % (C-06), validity of order links in days
MAX_QTY_PER_LINE=20
COUPON_MAX_PCT=90
ORDER_LINK_DAYS=30
# Restricted (18+) categories cannot be ordered online until compliance is confirmed (C-24)
ADULT_CHECKOUT_ENABLED=false
# Map tiles (C-09). Public OSM tiles are NOT for production traffic — use a provider with a key.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap
# WhatsApp Business Cloud API (optional automatic PDF delivery, C-03). Leave empty = manual wa.me only.
WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE=
WA_TEMPLATE_LANG=sq
WA_API_VERSION=v21.0
# Server
HOST=127.0.0.1
PORT=5000
